ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
# Optional: Use instead of ACTUAL_PASSWORD when your server enforces OpenID login (ACTUAL_OPENID_ENFORCE=true).
# A UUID session token copied from the browser after signing in. Takes precedence over ACTUAL_PASSWORD.
ACTUAL_SESSION_TOKEN=
ACTUAL_BUDGET_SYNC_ID=
# Optional: If your Actual server uses a different encryption budget password set it here
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
